# --- Python 缓存与编译文件 ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- 虚拟环境 ---
.venv/
venv/
env/
ENV/

# --- IDE 配置文件 ---
.idea/
.vscode/
*.swp
*.swo

# --- 环境变量与密钥 (建议加上，防止泄露密码) ---
.env
.env.*

# --- 日志、临时文件、系统文件 ---
*.log
.DS_Store
Thumbs.db
*.tmp

# 忽略所有 edge-farm-profile 前缀的目录
edge-farm-profile*/

# --- 构建与打包目录 (如果有) ---
build/
dist/
*.egg-info/